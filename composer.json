{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "test-projects/abelo-host",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "league/route": "^7.0",
        "monolog/monolog": "^3.12",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "smarty/smarty": "^5.8",
      "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Framework\\": "framework/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "composer i && php -S 0.0.0.0:80 -t public & npm run watch:css",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4",
        "vlucas/phpdotenv": "^5.7"
    }
}
